# ─── 사이트 ─────────────────────────────────────────────
# RSS / sitemap / OG 이미지의 절대 URL 생성에 쓰인다. 끝에 슬래시 없이.
# 예: https://example.com
NEXT_PUBLIC_SITE_URL=

# ─── Cloudflare R2 (이미지) ─────────────────────────────
# R2 버킷의 public 도메인. <Img> 컴포넌트가 여기서 직접 서빙한다.
# 절대 규칙 8: next/image 에 물리지 않는다.
# 예: https://img.example.com
NEXT_PUBLIC_IMAGE_BASE_URL=

# 아래 4개는 scripts/upload-image.ts (pnpm img) 전용 서버 시크릿.
# NEXT_PUBLIC_ 접두사를 붙이면 클라이언트 번들에 노출된다 — 절대 붙이지 말 것.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# 실제 값은 .env.local 에 채운다 (.env.local 은 커밋되지 않는다)
